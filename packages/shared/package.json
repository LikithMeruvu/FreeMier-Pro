{
  "name": "@freemier/shared",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./transitions": {
      "types": "./dist/calculations/transitions.d.ts",
      "default": "./dist/calculations/transitions.js"
    },
    "./animation": {
      "types": "./dist/calculations/animation.d.ts",
      "default": "./dist/calculations/animation.js"
    },
    "./effects": {
      "types": "./dist/calculations/effects.d.ts",
      "default": "./dist/calculations/effects.js"
    },
    "./timecode": {
      "types": "./dist/calculations/timecode.d.ts",
      "default": "./dist/calculations/timecode.js"
    },
    "./text": {
      "types": "./dist/titles/style.d.ts",
      "default": "./dist/titles/style.js"
    },
    "./srt": {
      "types": "./dist/captions/srt.d.ts",
      "default": "./dist/captions/srt.js"
    },
    "./captions": {
      "types": "./dist/captions/model.d.ts",
      "default": "./dist/captions/model.js"
    },
    "./presets": {
      "types": "./dist/resources/presets.d.ts",
      "default": "./dist/resources/presets.js"
    },
    "./workspace": {
      "types": "./dist/workspace/settings.d.ts",
      "default": "./dist/workspace/settings.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
